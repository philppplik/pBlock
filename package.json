{
  "name": "pblock",
  "version": "5.1.0",
  "description": "pBlock — Open-Source-Adblocker für Chrome (Manifest V3) mit 3-stufigem Filtersystem, Element-Picker und Cosmetic-Filtern.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Philipp Paulik",
  "homepage": "https://philppplik.github.io/pBlock/",
  "repository": {
    "type": "git",
    "url": "https://github.com/philppplik/pBlock.git"
  },
  "bugs": {
    "url": "https://github.com/philppplik/pBlock/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,css,html,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "package": "node scripts/package.mjs && node scripts/inspect-package.mjs",
    "inspect:package": "node scripts/inspect-package.mjs",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build && npm run validate:manifest",
    "audit:lists": "node scripts/audit-filter-lists.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "vitest": "^3.0.5"
  }
}
