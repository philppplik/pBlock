{
  "manifest_version": 3,
  "name": "pBlock",
  "version": "4.0.0",
  "description": "pBlock v4.0.0 - Blockiert Werbung, Tracker und Social Media mit 3-stufigem Filter-System, Element-Picker und Cosmetik-Filtern.",
  "homepage_url": "https://philipp-paulik.de",
  "author": "Philipp Paulik",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/dom-monitor.js", "js/scriptlets.js", "js/cosmetic-injector.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/element-picker.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wizard.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
